# Core
PORT=10000
HOST=0.0.0.0
LOG_LEVEL=INFO
ADMIN_TOKEN=change-me-long-random-token
PUBLIC_BASE_URL=https://your-service.onrender.com

# Ultra mode: many Telegram bots in one Python process.
# Tokens and webhook secrets live in separate environment variables.
BOTS_JSON=[{"name":"medbot","token_env":"BOT1_TOKEN","secret_env":"BOT1_WEBHOOK_SECRET","plugin":"titanbox.plugins.default:DefaultPlugin"}]
BOT1_TOKEN=123456:replace-me
BOT1_WEBHOOK_SECRET=replace_with_random_AZaz09_-_only
AUTO_REGISTER_WEBHOOKS=false
TELEGRAM_MAX_CONNECTIONS=10
WEBHOOK_MAX_INFLIGHT=24
WEBHOOK_HANDLER_TIMEOUT_SECONDS=10
MEMORY_PRESSURE_LIMIT_PCT=90

# Legacy runner: separate processes only when you cannot adapt a bot to Ultra mode.
ENABLE_RUNNER=false
APPS_CONFIG=/app/config/apps.toml

# Browser terminal: disabled by default. Enable only when actively administering.
ENABLE_TERMINAL=false
TERMINAL_USER=admin
TERMINAL_PASSWORD=replace-with-a-long-unique-password
TERMINAL_MAX_CLIENTS=1

# Deployment Admin Bot (optional, recommended for managing your own projects from Telegram)
# Add a bot descriptor using plugin titanbox.plugins.deploy_admin:DeployAdminPlugin to BOTS_JSON.
DEPLOY_ADMIN_TELEGRAM_IDS=123456789
DEPLOY_ROOT=/workspace/titanbox-data
DEPLOY_MAX_UPLOAD_BYTES=19000000
DEPLOY_MAX_ARCHIVE_FILES=5000
DEPLOY_MAX_EXTRACTED_BYTES=250000000
DEPLOY_KEEP_RELEASES=6
DEPLOY_STABILIZE_SECONDS=2
DEPLOY_RESTART_TIMEOUT_SECONDS=12
DEPLOY_MAX_CONCURRENT_OPS=1
